# Production settings for docker-compose.yml (e.g. on a DigitalOcean droplet).
#
#   cp .env.production.example .env
#   nano .env
#
# The full list of variables, with explanations, is in backend/.env.example.
# NODE_ENV, PORT and DB_PATH are fixed in docker-compose.yml — do not set them here.

# ── Address ───────────────────────────────────────────────────────────────────
# Hostname Caddy serves and fetches an HTTPS certificate for. Its DNS A record
# must point at the droplet before you start the stack. Leave it as ":80" to
# serve plain HTTP on the droplet's IP while you try things out.
DOMAIN=:80

# Public URL of the app, used for links in alert emails. Match DOMAIN, e.g.
# https://monitor.example.com — or http://<droplet-ip> while DOMAIN is ":80".
APP_URL=http://your-droplet-ip

# ── Sign-in ───────────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
# Required. Nobody can sign in until it is set.
AUTH_PASSWORD=
# Required. The server refuses to start without it. Generate one with:
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── LLM provider ──────────────────────────────────────────────────────────────
# "claude" uses Anthropic; anything else uses an OpenAI-compatible endpoint.
LLM_PROVIDER=claude
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── Scraper ───────────────────────────────────────────────────────────────────
# auto | firecrawl | brave | serper
SCRAPER_PROVIDER=auto
FIRECRAWL_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ── Scheduled scans & email ───────────────────────────────────────────────────
# Scheduled scans are on by default in production.
# Delete history older than this many days (blank keeps everything). Worth
# setting on a 25 GB droplet disk: snapshot bodies are the bulk of the database.
HISTORY_RETENTION_DAYS=180

# Outgoing mail. Without SMTP_HOST, alerts are logged instead of sent.
# DigitalOcean blocks outbound port 25 on droplets — use 587 or 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Website Monitor <no-reply@example.com>
