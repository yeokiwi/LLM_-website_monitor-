# Server
PORT=3001

# Public URL of the app. Used to build links in emails and the return URLs the
# payment gateways redirect to after checkout. In production it also becomes the
# only allowed CORS origin.
APP_URL=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# Accounts live in the database. People sign up through the app; there are no
# credentials in the environment except the platform administrator below.
#
# The administrator is the operator of the service, not a customer: it can see
# every account and subscription, and export or restore the whole database. It
# also inherits any data that predates user accounts when an existing
# single-tenant deployment is upgraded.
#
# Seeded on first boot only — changing AUTH_PASSWORD afterwards does NOT change
# the stored password (use "Change password" in the app instead).
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Secret used to sign JWT tokens — use a long random string in production.
# The server refuses to start in production if this is unset or left at its
# default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# How long a sign-in lasts (default: 24h). Examples: 12h, 7d, 30d
JWT_EXPIRES_IN=24h

# Require a confirmed email address before an account can use the app.
# Leave off unless SMTP below is configured, or new users will be locked out.
REQUIRE_EMAIL_VERIFICATION=false

# Disable request rate limiting. For local development and tests only.
DISABLE_RATE_LIMIT=false

# ── Billing ───────────────────────────────────────────────────────────────────
# Plans are defined in src/config/plans.js and upserted on boot. Paid plans only
# become purchasable once the matching gateway ids below are set.
#
# With neither gateway configured the app still runs — everyone stays on the
# free plan and the pricing page says paid plans are unavailable.

# How many days a subscriber keeps their plan after a failed payment, while
# the gateway retries the charge (default: 7).
BILLING_GRACE_DAYS=7

# --- Stripe -------------------------------------------------------------------
# Checkout and the Billing Portal are hosted by Stripe, so card details never
# reach this server. Create a recurring price per paid plan and paste its id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Point Stripe at:  POST {APP_URL}/api/billing/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted,
#         invoice.paid, invoice.payment_failed, charge.refunded
#
# Locally, forward them with:
#   stripe listen --forward-to localhost:3001/api/billing/webhooks/stripe

# --- PayPal -------------------------------------------------------------------
# Create a Catalog Product and a Billing Plan per paid tier, then paste the
# plan ids. PAYPAL_ENV is "sandbox" (default) or "live".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_BUSINESS=

# Point PayPal at:  POST {APP_URL}/api/billing/webhooks/paypal
# Events: BILLING.SUBSCRIPTION.ACTIVATED, BILLING.SUBSCRIPTION.UPDATED,
#         BILLING.SUBSCRIPTION.CANCELLED, BILLING.SUBSCRIPTION.SUSPENDED,
#         BILLING.SUBSCRIPTION.PAYMENT.FAILED, PAYMENT.SALE.COMPLETED,
#         PAYMENT.SALE.REFUNDED

# ── Scheduled scans ───────────────────────────────────────────────────────────
# Background scans run in-process on a 5-minute tick. On by default in
# production, off elsewhere so `npm run dev` does not spend API credit.
ENABLE_SCHEDULER=

# ── Email ─────────────────────────────────────────────────────────────────────
# Any SMTP provider works (Resend, SendGrid, SES, Postmark, Mailgun, …).
# When SMTP_HOST is unset, messages are logged instead of sent — signup and
# scanning keep working, they just do not deliver mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Website Monitor <no-reply@example.com>

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "claude" to use Anthropic, or any other value to use an
# OpenAI-compatible endpoint (openai, ollama, groq, mistral, etc.)
LLM_PROVIDER=claude

# Model name to use. Defaults: claude-opus-4-6 (Claude), gpt-4o (OpenAI-compat.)
# Note the Claude default is the most capable — and most expensive — tier, and
# it runs on every scan. Check it against your plan pricing; per-scan token
# usage is recorded on each scan_results row and totalled on /admin.
LLM_MODEL=

# Give up on an LLM call after this many milliseconds (default: 120000), so one
# hung request cannot stall a batch of scheduled scans.
LLM_TIMEOUT_MS=120000

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# ── OpenAI-compatible providers ───────────────────────────────────────────────
# API key — required for hosted services, can be any string for local models
# (Ollama and LM Studio do not check the key, but the field must not be empty)
OPENAI_API_KEY=

# Base URL for the OpenAI-compatible API endpoint.
# Leave blank to use OpenAI's default (https://api.openai.com/v1).
#
# Common values:
#   OpenAI (default)  https://api.openai.com/v1          (omit or leave blank)
#   Azure OpenAI      https://<resource>.openai.azure.com/openai/deployments/<deploy>
#   Ollama            http://localhost:11434/v1
#   LM Studio         http://localhost:1234/v1
#   Groq              https://api.groq.com/openai/v1
#   Together AI       https://api.together.xyz/v1
#   Mistral AI        https://api.mistral.ai/v1
#   Perplexity        https://api.perplexity.ai
#   DeepSeek          https://api.deepseek.com/v1
OPENAI_BASE_URL=

# ── Scraper provider ──────────────────────────────────────────────────────────
# Which scraper to use: brave | serper | firecrawl | auto (default: auto)
# auto = use Firecrawl if FIRECRAWL_API_KEY is set, else Brave if BRAVE_API_KEY
#        is set, else Serper if SERPER_API_KEY is set, else direct axios+cheerio
#        scraping.
#
# Which engines a given scan may use is also limited by the account's plan: the
# free tier falls back to direct scraping even when these keys are present, so
# it cannot spend paid search credit.
SCRAPER_PROVIDER=auto

# ── Brave Search API ──────────────────────────────────────────────────────────
# Enables Brave's indexed content for change detection (recommended).
# Falls back to direct axios+cheerio scraping if not set.
BRAVE_API_KEY=

# ── Serper Search API ─────────────────────────────────────────────────────────
# Alternative to Brave — Google Search results via Serper (https://serper.dev).
# Enables indexed content + news for change detection. Get a key at serper.dev.
SERPER_API_KEY=

# ── Firecrawl ─────────────────────────────────────────────────────────────────
# Full-page markdown scraping via Firecrawl (https://firecrawl.dev) — captures
# the actual rendered page content for richer diffs than Brave's snippets.
# Get a key at https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Optional: override the API base (e.g. a self-hosted Firecrawl instance).
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database file path (relative to backend/). Created automatically.
DB_PATH=./data/monitor.db
