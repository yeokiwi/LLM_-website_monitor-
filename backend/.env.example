# Server
PORT=3001

# ── Authentication ────────────────────────────────────────────────────────────
# Username for the login page (default: admin)
AUTH_USERNAME=admin

# Password for the login page — REQUIRED, no default
AUTH_PASSWORD=change-me

# Secret used to sign JWT tokens — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# How long a login session stays valid (default: 24h)
# Examples: 12h, 7d, 30d
JWT_EXPIRES_IN=24h

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "claude" to use Anthropic, or any other value to use an
# OpenAI-compatible endpoint (openai, ollama, groq, mistral, etc.)
LLM_PROVIDER=claude

# Model name to use. Defaults: claude-opus-4-6 (Claude), gpt-4o (OpenAI-compat.)
# Examples: claude-sonnet-4-6, gpt-4-turbo, llama3.2, mistral-7b, mixtral-8x7b
LLM_MODEL=

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# ── OpenAI-compatible providers ───────────────────────────────────────────────
# API key — required for hosted services, can be any string for local models
# (Ollama and LM Studio do not check the key, but the field must not be empty)
OPENAI_API_KEY=

# Base URL for the OpenAI-compatible API endpoint.
# Leave blank to use OpenAI's default (https://api.openai.com/v1).
#
# Common values:
#   OpenAI (default)  https://api.openai.com/v1          (omit or leave blank)
#   Azure OpenAI      https://<resource>.openai.azure.com/openai/deployments/<deploy>
#   Ollama            http://localhost:11434/v1
#   LM Studio         http://localhost:1234/v1
#   Groq              https://api.groq.com/openai/v1
#   Together AI       https://api.together.xyz/v1
#   Mistral AI        https://api.mistral.ai/v1
#   Perplexity        https://api.perplexity.ai
#   DeepSeek          https://api.deepseek.com/v1
OPENAI_BASE_URL=

# ── Web search / scraping provider ────────────────────────────────────────────
# Which method captures page content for change detection:
#   brave   → Brave Search API   (needs BRAVE_API_KEY)
#   searxng → a SearXNG instance (needs SEARXNG_URL)
#   direct  → direct axios+cheerio fetch (no external service)
# If unset, auto-detects: brave if BRAVE_API_KEY is set, else searxng if
# SEARXNG_URL is set, otherwise direct.
SEARCH_PROVIDER=

# Brave Search API key — used when SEARCH_PROVIDER=brave (or auto-detected).
BRAVE_API_KEY=

# SearXNG base URL — used when SEARCH_PROVIDER=searxng. The instance must have
# JSON output enabled (search.formats must include "json" in its settings.yml).
# Basic-auth credentials may be embedded: https://user:pass@searxng.example.com
SEARXNG_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database file path (relative to backend/). Created automatically.
DB_PATH=./data/monitor.db
