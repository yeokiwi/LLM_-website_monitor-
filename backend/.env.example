# Server
PORT=3001

# LLM Provider: "claude" or "openai"
LLM_PROVIDER=claude

# Anthropic (Claude) API key — used when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# OpenAI API key — used when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Brave Search API key (https://api.search.brave.com)
# If set, Brave API is used for content discovery (recommended).
# If not set, falls back to direct axios+cheerio scraping.
BRAVE_API_KEY=

# SQLite database file path (relative to backend/)
DB_PATH=./data/monitor.db
