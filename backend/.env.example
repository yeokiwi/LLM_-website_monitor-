# Server
PORT=3001

# Public URL of the app. Used to build links in change-alert emails. In
# production it also becomes the only allowed CORS origin.
APP_URL=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# One shared login for the whole deployment. There is no signup and no password
# recovery: these two values ARE the credentials, and changing AUTH_PASSWORD
# takes effect as soon as the server restarts.
#
# Nobody can sign in until AUTH_PASSWORD is set. Anyone who has it sees every
# monitored site, so treat it like a production secret.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Secret used to sign JWT tokens — use a long random string in production.
# The server refuses to start in production if this is unset or left at its
# default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# How long a sign-in lasts (default: 24h). Examples: 12h, 7d, 30d
JWT_EXPIRES_IN=24h

# Disable request rate limiting. For local development and tests only.
# The login endpoint is rate limited per IP; with a single shared password that
# limit is what makes brute-forcing impractical, so leave it on in production.
DISABLE_RATE_LIMIT=false

# ── Scheduled scans ───────────────────────────────────────────────────────────
# Background scans run in-process on a 5-minute tick. On by default in
# production, off elsewhere so `npm run dev` does not spend API credit.
ENABLE_SCHEDULER=

# Delete scans and snapshot bodies older than this many days, swept once a day.
# Leave blank to keep everything. Snapshot bodies are the bulk of the database,
# so on a long-running instance this is what keeps the file from growing without
# bound.
HISTORY_RETENTION_DAYS=

# ── Email ─────────────────────────────────────────────────────────────────────
# Any SMTP provider works (Resend, SendGrid, SES, Postmark, Mailgun, …).
# The only message sent is the change alert from a scheduled scan. When
# SMTP_HOST is unset, it is logged instead of sent — which is also how you turn
# change alerts off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Website Monitor <no-reply@example.com>

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "claude" to use Anthropic, or any other value to use an
# OpenAI-compatible endpoint (openai, ollama, groq, mistral, etc.)
LLM_PROVIDER=claude

# Model name to use. Defaults: claude-opus-4-6 (Claude), gpt-4o (OpenAI-compat.)
# Note the Claude default is the most capable — and most expensive — tier, and
# it runs on every scan. Per-scan token usage is recorded on each scan_results
# row, so it can be totalled from the database.
LLM_MODEL=

# Give up on an LLM call after this many milliseconds (default: 120000), so one
# hung request cannot stall a batch of scheduled scans.
LLM_TIMEOUT_MS=120000

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# ── OpenAI-compatible providers ───────────────────────────────────────────────
# API key — required for hosted services, can be any string for local models
# (Ollama and LM Studio do not check the key, but the field must not be empty)
OPENAI_API_KEY=

# Base URL for the OpenAI-compatible API endpoint.
# Leave blank to use OpenAI's default (https://api.openai.com/v1).
#
# Common values:
#   OpenAI (default)  https://api.openai.com/v1          (omit or leave blank)
#   Azure OpenAI      https://<resource>.openai.azure.com/openai/deployments/<deploy>
#   Ollama            http://localhost:11434/v1
#   LM Studio         http://localhost:1234/v1
#   Groq              https://api.groq.com/openai/v1
#   Together AI       https://api.together.xyz/v1
#   Mistral AI        https://api.mistral.ai/v1
#   Perplexity        https://api.perplexity.ai
#   DeepSeek          https://api.deepseek.com/v1
OPENAI_BASE_URL=

# ── Scraper provider ──────────────────────────────────────────────────────────
# Which scraper to use: brave | serper | firecrawl | auto (default: auto)
# auto = use Firecrawl if FIRECRAWL_API_KEY is set, else Brave if BRAVE_API_KEY
#        is set, else Serper if SERPER_API_KEY is set, else direct axios+cheerio
#        scraping.
#
# A per-website engine choice is intersected with the keys set below: a site
# configured for Firecrawl on a deployment with no Firecrawl key falls back to
# direct scraping rather than failing.
SCRAPER_PROVIDER=auto

# ── Brave Search API ──────────────────────────────────────────────────────────
# Enables Brave's indexed content for change detection (recommended).
# Falls back to direct axios+cheerio scraping if not set.
BRAVE_API_KEY=

# ── Serper Search API ─────────────────────────────────────────────────────────
# Alternative to Brave — Google Search results via Serper (https://serper.dev).
# Enables indexed content + news for change detection. Get a key at serper.dev.
SERPER_API_KEY=

# ── Firecrawl ─────────────────────────────────────────────────────────────────
# Full-page markdown scraping via Firecrawl (https://firecrawl.dev) — captures
# the actual rendered page content for richer diffs than Brave's snippets.
# Get a key at https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Optional: override the API base (e.g. a self-hosted Firecrawl instance).
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database file path (relative to backend/). Created automatically.
DB_PATH=./data/monitor.db
